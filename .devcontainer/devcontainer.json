{
  "name": "Test Data Factory",
  "dockerComposeFile": "docker-compose.yml",
  "service": "test-data-factory-app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "overrideCommand": false,
  "shutdownAction": "stopCompose",
  "remoteUser": "developer",
  "mounts": [
    "source=${localEnv:USERPROFILE}/.config/opencode/opencode.json,target=/home/developer/.config/opencode/opencode.json,type=bind,readonly",
    "source=${localEnv:USERPROFILE}/.local/share/opencode/auth.json,target=/home/developer/.local/share/opencode/auth.json,type=bind,readonly"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.debugpy",
        "bierner.markdown-mermaid"
      ]
    }
  },
  "postCreateCommand": ".devcontainer/post-create.sh"
}
